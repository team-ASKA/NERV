{
  "name": "nerv-interview-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "npm run typecheck:app && npm run typecheck:api && npm run typecheck:node",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@monaco-editor/react": "^4.7.0",
    "@splinetool/react-spline": "^4.0.0",
    "@splinetool/runtime": "^1.9.80",
    "@supabase/supabase-js": "^2.99.1",
    "bullmq": "^5.34.0",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.0",
    "firebase": "^11.5.0",
    "framer-motion": "^11.0.8",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.344.0",
    "pdfjs-dist": "^4.10.38",
    "posthog-js": "^1.360.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.6.15",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.2.2",
    "vitest": "^4.1.11"
  }
}
