# ============================================================================
# NERV — Environment Variables
# ============================================================================
# Copy this file to `.env` (local) and configure the same values in your
# Vercel Project Settings → Environment Variables. The worker is a separate
# deploy (Railway / Render / Fly / ECS) with its own variable set — see the
# WORKER section at the bottom and `worker/README.md`.
#
# THREE TIERS, and the boundary between them is a security boundary:
#
#   1. CLIENT  (VITE_ prefix)  — compiled into the browser bundle. PUBLIC by
#      design; assume anyone can read it. Only Firebase web config, the
#      Supabase anon key, the PostHog project key, and feature switches.
#
#   2. SERVERLESS (no prefix)  — readable only by the functions in /api.
#      Every AI provider secret lives here. The client reaches these
#      providers exclusively through /api/*, so no model key is ever in a
#      browser network call.
#
#   3. WORKER (no prefix)      — readable only by the BullMQ worker process.
#      Holds the Postgres URL and the Supabase SERVICE ROLE key, which
#      bypasses row-level security and must never reach a browser or a
#      client-side bundle.
#
# Nothing in the app throws at import time over a missing variable. Each
# subsystem reports itself unavailable and the product degrades honestly:
# no model key means scripted fallbacks, no Redis means synchronous parsing,
# no emotion provider means the panel says so rather than inventing numbers.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. CLIENT — safe to ship to the browser (VITE_ prefix)
# ----------------------------------------------------------------------------

# Firebase (authentication only). These are public web-app config values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase (application data). The anon key is public by design; row-level
# security is what protects the data. `VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY`
# is accepted as an alias for projects issued the newer publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# PostHog product analytics (optional). Project key is public.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional: override the base URL used for /api calls. Leave blank to use the
# same origin (recommended for Vercel and for `vercel dev`).
VITE_API_URL=

# --- Facial expression provider ---------------------------------------------
# mediapipe (default) local in-browser model; webcam frames never leave device
# hume      cloud streaming, ONLY with explicit per-session user opt-in
# off       disable expression capture; the panel reports unavailable
#
# NOTE: the old `auto` value (local-then-Hume fallback) was removed: local
# failure now stays unavailable unless the user opted into cloud processing.
VITE_EMOTION_PROVIDER=mediapipe

# Self-host the MediaPipe vision bundle + WASM instead of using jsDelivr.
# Must serve `<base>/vision_bundle.mjs` and `<base>/wasm/`.
VITE_VISION_CDN=

# Self-host the FaceLandmarker `.task` model file.
VITE_FACE_MODEL_URL=


# ----------------------------------------------------------------------------
# 2. SERVERLESS — /api functions only (NO VITE_ prefix, never sent to client)
# ----------------------------------------------------------------------------

# Google Gemini — interview fallback + summaries. Model is deployment config:
# GEMINI_MODEL must name a model available on YOUR account (retirements apply).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (Llama) — primary interview engine, resume parsing, tutor.
GROQ_API_KEY=

# Optional override for the serverless interview model.
# Default: llama-3.3-70b-versatile (verify against your account's access list)
GROQ_MODEL=
GROQ_TEXT_MODEL=

# Sarvam AI — speech-to-text and text-to-speech, proxied via /api/stt and
# /api/tts so the key stays server-side. Model/voice are validated config.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# Hume AI — only needed when VITE_EMOTION_PROVIDER is `hume` (or as the `auto`
# fallback). The server mints short-lived access tokens at /api/emotion/token;
# the secret key is NEVER exposed to the browser.
HUME_API_KEY=
HUME_SECRET_KEY=

# Supabase server credentials. SUPABASE_SECRET_KEY is canonical; the legacy
# SUPABASE_SERVICE_ROLE_KEY alias is still accepted (do not set both to
# different values). Server/worker only, never a VITE_ variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket holding uploaded PDFs. Default: resumes
RESUME_BUCKET=

# Redis / Valkey connection string, shared with the worker. Two jobs:
#   1. The ingestion queue. When absent the upload endpoint parses inline
#      instead of enqueuing, so the product still works — just without the
#      queue's retries and backpressure.
#   2. Per-user rate limiting on every paid endpoint. When absent the limiter
#      fails OPEN: nothing is throttled, and one account can spend the whole
#      project's model quota. Fine for local work, but set this before any
#      real traffic — it is the only thing bounding spend per user.
# Use rediss:// for TLS (Upstash, Redis Cloud).
REDIS_URL=

# Firebase project id used to verify ID tokens. Falls back to
# VITE_FIREBASE_PROJECT_ID when unset, so it is usually redundant.
FIREBASE_PROJECT_ID=

# DANGEROUS — accepts unverified ID tokens. Local development only, to let the
# API be exercised without Firebase configured. Never set this in production:
# it lets a caller claim any uid (and the server refuses it there).
# ALLOW_UNVERIFIED_AUTH=false

# Production rate-limit policy when Redis is down: default is FAIL CLOSED in
# production (429) so an outage cannot become unlimited paid spend. Set
# RATE_LIMIT_FAIL_OPEN=true only as an explicit degraded-mode decision.
# RATE_LIMIT_FAIL_OPEN=

# Demo mode (development only): VITE_DEMO_MODE=mock serves labelled synthetic
# fixtures with no keys. Production builds reject it.
# VITE_DEMO_MODE=
# DEMO_MODE=

# Release mode / runtime.
# NODE_ENV=development


# ----------------------------------------------------------------------------
# 3. WORKER — the BullMQ process (`worker/`), deployed separately
# ----------------------------------------------------------------------------
# Not Vercel: this is a long-lived process, not a serverless function.
# Needs REDIS_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, GROQ_API_KEY and
# GEMINI_API_KEY from the sections above, plus:

# Postgres, connected directly (not through PostgREST). Use the TRANSACTION
# POOLER — port 6543 on Supabase — not the direct 5432 connection: every
# replica holds a pool, and the pooler is what keeps replicas × DB_POOL_MAX
# under the server's connection limit. Every DB function used by the worker is
# transaction-scoped, so transaction pooling is safe.
DATABASE_URL=

# Connections per pod. Multiply by your replica count and stay under the
# Postgres limit. Default: 8
DB_POOL_MAX=

# Keep the source PDF after a successful parse. Default: false — the structured
# parse and raw text are what the product reads, so at scale the originals are
# storage cost with no consumer.
RESUME_RETAIN_PDF=false

# Resume versions kept per user; older rows are pruned after each successful
# ingestion so the table stays bounded. Default: 3
RESUMES_PER_USER=

# Extraction models. The router picks the vision path only when the PDF's own
# text layer is too thin to trust (a scan or an image-only export).
# Defaults: meta-llama/llama-4-scout-17b-16e-instruct, llama-3.1-8b-instant
GROQ_VISION_MODEL=
GROQ_TEXT_MODEL=

# Jobs processed concurrently per pod. Ingestion is IO- and API-bound so it can
# exceed the core count; the LLM limiter below is the real ceiling.
# Defaults: 4, 2
INGEST_CONCURRENCY=
SIM_CONCURRENCY=

# Token-bucket ceiling for outbound model calls, per pod. Keep
# LLM_RPM × replicas under your provider account limit. Default: 90
LLM_RPM=

# --- Interview simulation ----------------------------------------------------
# After each successful ingest the worker interviews a synthetic candidate with
# the production persona. Two purposes:
#   • prime — 3 calls, always. Writes the opening question for each round so
#     the candidate's first question costs no model time at all.
#   • audit — ~34 calls, sampled. Replays a full interview and critiques it, so
#     a prompt regression is caught by us and not by a candidate mid-round.
# Default: true
ENABLE_INTERVIEW_SIM=

# Share of ingests that also get a full audit (0..1). Priming stays
# unconditional at 0 — this only governs the expensive path. Default: 0.05
SIM_AUDIT_RATE=

# Port for the /healthz and /readyz endpoints your platform probes.
# Default: 8080
PORT=

# pino level: trace | debug | info | warn | error | fatal. Default: info
LOG_LEVEL=
