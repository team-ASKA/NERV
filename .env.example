# ============================================================================
# NERV — Environment Variables
# ============================================================================
# Copy this file to `.env` (local) and/or configure these in your Vercel
# Project Settings → Environment Variables.
#
# TWO CATEGORIES:
#   1. CLIENT  (VITE_ prefix)  — bundled into the browser build. PUBLIC by
#      design. Only put values here that are safe to expose (Firebase web
#      config, Supabase anon key, PostHog project key).
#   2. SERVER  (no VITE_ prefix) — available ONLY to the serverless functions
#      in /api. NEVER expose an AI provider secret to the client.
# ============================================================================


# ----------------------------------------------------------------------------
# CLIENT — safe to ship to the browser (VITE_ prefix)
# ----------------------------------------------------------------------------

# Firebase (authentication only). These are public web-app config values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase (application data). The anon key is public by design; row-level
# security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog product analytics (optional). Project key is public.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional: override the base URL used for /api calls. Leave blank to use the
# same origin (recommended for Vercel + `vercel dev`).
VITE_API_URL=


# ----------------------------------------------------------------------------
# SERVER — serverless functions only (NO VITE_ prefix, never sent to client)
# ----------------------------------------------------------------------------

# Google Gemini — interview question generation (fallback) + summaries.
GEMINI_API_KEY=

# Groq (Llama 3.1) — primary interview engine, resume parsing, tutor.
GROQ_API_KEY=

# Sarvam AI — speech-to-text and text-to-speech (proxied via /api/stt, /api/tts).
SARVAM_API_KEY=

# Hume AI — facial emotion. The server mints short-lived access tokens
# (/api/emotion/token); the secret key is NEVER exposed to the browser.
HUME_API_KEY=
HUME_SECRET_KEY=
