{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    /* NodeNext, not bundler: this is a real Node ESM process, so the compiler
       must enforce the explicit `.js` specifiers Node's loader requires. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* `shared/` sits outside this package, so the emitted tree is rooted at the
       repo to keep both under one predictable output layout:
         dist/worker/src/index.js
         dist/shared/*.js                                                    */
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
