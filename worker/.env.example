# NERV worker — explicit env source (root .env is NOT auto-loaded by tsx/node).
# Load with: `dotenv -e worker/.env -- tsx watch worker/src/index.ts`
# or `node --env-file=worker/.env dist/worker/src/index.js`.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

REDIS_URL=
DATABASE_URL=
# Optional custom CA bundle for verified Postgres TLS (otherwise platform trust).
PG_CA=
DB_POOL_MAX=8

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alias still accepted; do not set both to different values.
# SUPABASE_SERVICE_ROLE_KEY=
RESUME_BUCKET=resumes
RESUME_RETAIN_PDF=false
RESUMES_PER_USER=3

GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

INGEST_CONCURRENCY=4
SIM_CONCURRENCY=2
LLM_RPM=90
ENABLE_INTERVIEW_SIM=true
SIM_AUDIT_RATE=0.05
